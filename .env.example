# Nome deste nó no Tailscale: forca-a em um PC, forca-b no outro.
NODE_NAME=forca-a
# host:porta de sincronização do OUTRO nó. No PC forca-a use forca-b:5001; no forca-b, forca-a:5001.
PEER=forca-b:5001
# Chave de autenticação do Tailscale (reutilizável, com a tag tag:forca). Recebida em particular; não versione.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXX
# Mesmo valor nos dois nós. Troque o padrão.
REPLICATION_KEY=troque-esta-chave
